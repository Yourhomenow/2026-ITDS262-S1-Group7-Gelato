# Copy to server/.env — Bun loads .env automatically, no dotenv needed.

# Server
PORT=3005
NODE_ENV=development

# HTTP seam
# Browser origin allowed by credentialed CORS.
CLIENTS_ORIGIN=http://localhost:3000
# Session cookie name (the sign in feature sets the cookie).
SESSION_COOKIE_NAME=gelato_session

# PostgreSQL (defaults live in src/config/index.ts; the schema is in database/schema.sql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gelato
DB_USER=postgres
DB_PASSWORD=
